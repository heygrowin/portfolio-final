# Database connection
# For production/Neon Postgres: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# If left blank or sqlite, local development uses SQLite automatically
DATABASE_URI=

# Payload Secret (min 32 chars)
PAYLOAD_SECRET=your-super-secret-key-at-least-32-chars-long-here

# Public Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 Media (Optional in local dev, fallback to local storage)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
